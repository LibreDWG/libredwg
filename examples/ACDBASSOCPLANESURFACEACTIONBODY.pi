  Offsets=[66, 0, 61, 12, 0], % hdloff, strsize, commonsize, bitsize, hdlsize
  S="010000000110100100000001101010001000001110101010100000000011001000000101000011100100001000000101000011010",
  % name: [1] bits, [2] value, [3] poslist, [4] fieldname, [5] dxfcode
  Fields = [
     new_struct('H330', ["00000000", '8.0.0', [], "ownerhandle", 330])
    ,new_struct('BL90', ["0100000001", '1', [], "aab_version", 90])
    ,new_struct('BL90', ["10", '0', [], "pab_status", 90])
    ,new_struct('BL90', ["10", '0', [], "pab_l2", 90])
    ,new_struct('BL90', ["0100000001", '1', [], "num_deps", 90])
    ,new_struct('H360', ["001100100000010100001110", '3.2.50E', [], "writedeps", 360])
    ,new_struct('BL90', ["10", '0', [], "pab_l4", 90])
    ,new_struct('BL90', ["10", '0', [], "pab_l5", 90])
    ,new_struct('BL90', ["10", '0', [], "sab_status", 90])
    ,new_struct('H330', ["010000100000010100001101", '4.2.50D', [], "", 330])
    ,new_struct('B290', ["0", '0', [], "sab_b1", 290])
    ,new_struct('BL90', ["0100000111", '7', [], "sab_l2", 90])
    ,new_struct('B290', ["0", '0', [], "sab_b2", 290])
    ,new_struct('BS70', ["10", '0', [], "sab_s1", 70])
    ,new_struct('BL90', ["10", '0', [], "pbsab_status", 90])
    ,new_struct('BL90', ["10", '0', [], "psab_status", 90])
  ],
  Data = [S,Fields,Class,Dxf,Version,Offsets],
