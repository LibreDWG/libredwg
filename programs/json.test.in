[ -z "$DATADIR" ] && DATADIR="@top_srcdir@/test/test-data"
top_builddir="@top_builddir@"
EXEEXT="@EXEEXT@"
TESTS_ENVIRONMENT="@AM_TESTS_ENVIRONMENT@"
# artefact for "shellcheck"
[ -z "$top_builddir" ] && echo $top_builddir

i=0
DATA="sample_2000 example_2000 example_2004 example_2007 example_2010"
DATA="$DATA example_2013 example_2018 example_r14 example_r13"
DATA="$DATA r11/entities-3d r2.10/entities r2.6/entities r10/entities"
#     eed        numentities
TODO="r11/ACEB10 r1.4/entities"
SED="@SED@"
JQ="@JQ@"
GEOJSONLINT="@GEOJSONLINT@"
[ -z "$SED" ] && echo "$SED"
[ -z "$JQ" ] && echo "$JQ"
[ -z "$GEOJSONLINT" ] && echo "$GEOJSONLINT"
HAVE_ODA="@HAVE_ODA@"
ODAFileConverter="@ODAFILECONVERTER@"
if [ -n "$HAVE_ODA" ]; then
    baseFileConverter="$(basename "$ODAFileConverter")"
fi
XVFB_RUN="@XVFB_RUN@"
if [ -n "$XVFB_RUN" ]; then
    ODAFileConverter="$XVFB_RUN $ODAFileConverter"
    baseFileConverter="@XVFB_RUN@ $baseFileConverter"
fi

for d in $TODO $DATA; do
    b="$(basename "$d")"
    rm "./$b.json" 2>/dev/null
done

# shellcheck disable=2157
if [ -n "$VALGRIND" ] && [ -n "$LOG_COMPILER" ]; then
    TESTPROG="$LOG_COMPILER $LOG_FLAGS"
elif [ -n "@WINE@" ]; then
    TESTPROG="@WINE@"
elif [ -n "$TESTS_ENVIRONMENT" ]; then
    TESTPROG="$TESTS_ENVIRONMENT @LTEXEC@"
else
    TESTPROG="@LTEXEC@"
fi

check_roundtrip() {
    if [ -f "$dwg" ] && [ -x dwgwrite ]
    then
        json="$(basename "$dwg" .dwg).json"
        tgt="$(basename "$dwg")"
        log1="$(basename "$dwg" .dwg).log.orig"
        log2="$(basename "$dwg" .dwg).log"
        todo=
        as=
        case $dwg in
            *r11/A*)      todo=1 ;;
            *r1.*)        todo=1 ;;
            *2007*)       as=--as=r2000 ;;
            *201*)        as=--as=r2000 ;;
        esac
        echo "./dwgread${EXEEXT} -v2 -o $json $dwg 2>$log1"
        if ! $TESTPROG "./dwgread${EXEEXT}" -v2 -o "$json" "$dwg" 2>"$log1" >/dev/null; then
            echo "json $dwg failed"
            tail "$log1"
            if [ -z $todo ]; then i=$((i+1)); fi
        fi
        echo "./dwgwrite${EXEEXT} -y -v0 $as -o $tgt $json"
        # shellcheck disable=SC2086
        if ! $TESTPROG "./dwgwrite${EXEEXT}" -y -v0 $as -o "$tgt" "$json" 2>/dev/null >/dev/null; then
            echo "dwgwrite $json failed"
            if [ -z $todo ]; then i=$((i+1)); fi
        fi
        echo "./dwgread${EXEEXT} -v2 $tgt 2>$log2"
        if ! $TESTPROG "./dwgread${EXEEXT}" -v2 "$tgt" 2>"$log2" >/dev/null; then
            echo "dwgread resulting $tgt failed"
            tail "$log2"
            if [ -z $todo ]; then i=$((i+1)); fi
        fi
        expect1="$(grep -E -c '^Add entity' "$log1")"
        got1="$(grep -E -c '^Add entity' "$log2")"
        expect2="$(grep -E -c '^Add object' "$log1")"
        got2="$(grep -E -c '^Add object' "$log2")"
        rm "./$json" "./$tgt" 2>/dev/null
        if [ "$got1" -ge "$expect1" ] && [ "$got2" -ge "$expect2" ]
        then
            echo "$json roundtrip ok"
            rm "./$log1" "./$log2" 2>/dev/null
        else
            echo "$json" "roundtrip fail: $expect1 vs $got1 entities, $expect2 vs $got2 objects"
            if [ -z $todo ]; then
                i=$((i+1))
                echo "expect entities: $expect1" >"$log"
                # shellcheck disable=SC2129
                echo "got    entities: $got1"    >>"$log"
                echo "expect objects:  $expect2" >>"$log"
                echo "got    objects:  $got2"    >>"$log"
            else
                rm "./$log1" "./$log2" 2>/dev/null
            fi
        fi
    fi
}

for dwg in $DATA $TODO; do
    json="$(basename "$dwg" .dwg).json"
    log="$json.log"
    todo=
    case " $TODO " in
        *" $dwg "*) todo=1 ;;
    esac
    dwg="${DATADIR}/$dwg.dwg"
    echo "dwgread${EXEEXT}" -Ojson -o"$json" "$dwg"
    # With --enable-debug fixup nan
    if $TESTPROG "./dwgread${EXEEXT}" -Ojson -o"$json" "$dwg" 2>/dev/null && \
       @JSON_SED_NAN@ "$json" && \
       $JQ . "$json" >"$json.log" 2>&1
    then
        rm "./$json.log" "./$json"
    else
        cat "$json.log"
        if [ -z "$todo" ]; then i=$((i+1)); fi
    fi

    minjson="$(basename "$dwg" .dwg).min.json"
    echo "./dwgread${EXEEXT} -Ominjson -o$minjson $dwg && jq . $minjson"
    if $TESTPROG "./dwgread${EXEEXT}" -Ominjson -o"$minjson" "$dwg" 2>/dev/null && \
       @JSON_SED_NAN@ "$minjson" && \
       $JQ . "$minjson" >>"$json.log" 2>&1
    then
       rm "./$json.log" "./$minjson"
    else
        cat "$json.log"
        if [ -z "$todo" ]; then i=$((i+1)); fi
    fi

    geojson="$(basename "$dwg" .dwg).geojson"
    echo "./dwgread${EXEEXT}" -o"$geojson" "$dwg"
    if $TESTPROG "./dwgread${EXEEXT}" -Ogeojson -o"$geojson" "$dwg" 2>/dev/null && \
       @JSON_SED_NAN@ "$geojson" && \
       $JQ . "$geojson" >>"$json.log" 2>&1
    then
        if [ -n "$GEOJSONLINT" ]; then
            if [ -z "$todo" ]; then
                $GEOJSONLINT "$geojson" ||
                    i=$((i+1))
            fi
        fi
        rm "./$json.log" "./$geojson"
    else
        cat "$json.log"
        if [ -z "$todo" ]; then i=$((i+1)); fi
    fi

    check_roundtrip
done

# oda/teigha supports r9-r2018. r2.10: Unsupported early .dwg file version
can_teigha=1

check_oda() {
    if [ -n "$ODAFileConverter" ]
    then
        b="$(basename "$dwg")"
        dir="$(dirname "$dwg")"
        r="$(basename "$dir")"
        can_teigha=1
        case $r in
            20*)      b="${b}_${r}" ;;
            r9)       r=9; b="${b}_r${r}" ;;
            r11)      r=12; b="${b}_r${r}" ;;
            r1[0234]) r=${r:1}; b="${b}_r${r}" ;;
            r[12]\.*) r=${r:1}
                      can_teigha=
                      ;;
            .)  case $b in
                    *_20*)      r="${b:(-4)}" ;;
                    *_r9)       r=9           ;;
                    *_r11)      r=12          ;;
                    *_r1[0234]) r="${b:(-2)}" ;;
                esac
                ;;
        esac
        if [ -n "$can_teigha" ] && [ ! -f "$b.dwg" ]; then
            if [ ! -f "$b.json" ]; then
                echo "dwgread${EXEEXT}" -o"$b.json" "${DATADIR}/$dwg.dwg"
                $TESTPROG "./dwgread${EXEEXT}" -o"$b.json" "${DATADIR}/$dwg.dwg" 2>/dev/null
            fi
            echo "./dwgwrite${EXEEXT} -y -v0 -o $b.dwg $b.json"
            $TESTPROG "./dwgwrite${EXEEXT}" -y -v0 -o "$b.dwg" "$b.json" 2>/dev/null
        fi
        # shellcheck disable=SC2086,SC2154
        if [ -n "$can_teigha" ] && [ -f "$b.dwg" ]; then
            echo $baseFileConverter . .. "ACAD$r" DXF 0 1 "$b.dwg" from "$dwg"
            $ODAFileConverter . .. "ACAD$r" DXF 0 1 "$b.dwg" \
                $ODAFileConverter_geometry >/dev/null 2>/dev/null
            if [ -e "../$b.dxf.err" ]; then
                mv "../$b.dxf.err" "$b.json.err"
                cat "$b.json.err"
                if [ -z "$todo_oda" ]; then
                    i=$((i+1))
                fi
            fi
            rm -f "../$b.dxf" "./$b.dwg" "./$b.json"
        else
            rm -f "./$b.json.err" "./$b.dwg" "./$b.json" 2>/dev/null
        fi
    fi
}

if [ -n "$can_teigha" ] && [ -n "$ODAFileConverter" ]
then
    echo ""
    echo "$baseFileConverter roundtrip checks"
    # example_r14: CRC does not match
    # example_2000, example_2004: ODA regression (AcDbVisualStyle cast)
    for dwg in sample_2000 example_2000 2000/Arc 2000/Text 2000/circle \
               2000/PolyLine2D 2000/RAY 2000/Spline \
               r11/entities-3d r11/entities-2d example_2004
    do
        todo_oda=
        case $dwg in
            example_2000|example_2004) todo_oda=1 ;;
        esac
        check_oda
    done
else
    echo "$baseFileConverter not installed"
fi

if [ -n "$JQ" ]
then
    # check pipe (nocomma)
    dwg="$DATADIR/example_2000.dwg"
    json="example_2000.json"
    echo "dwgread -O geojson $DATADIR/example_2000.dwg | jq ."
    if $TESTPROG "./dwgread${EXEEXT}" -O geojson "$DATADIR/example_2000.dwg" | $JQ . >"$json.log" 2>&1
    then
        echo pipe to geojson ok
        rm "./$json.log"
    else
        cat "$json.log"
        i=$((i+1))
    fi

    echo "dwgread -O json $DATADIR/example_2000.dwg | jq ."
    if $TESTPROG "./dwgread${EXEEXT}" -O json "$DATADIR/example_2000.dwg" | $JQ . >"$json.log" 2>&1
    then
        echo pipe to json ok
        rm "./$json.log"
    else
        cat "$json.log"
        i=$((i+1))
    fi

    # block attributes as properties, GH #849
    echo "dwgread -O geojson $DATADIR/example_2000.dwg | jq attribs"
    if $TESTPROG "./dwgread${EXEEXT}" -O geojson "$DATADIR/example_2000.dwg" |
        $JQ -e '[.features[].properties.ETIKEDO // empty] | sort
                == ["valoro", "valoro de la teksto en bloko"]' >/dev/null 2>&1
    then
        echo geojson attribs ok
    else
        i=$((i+1))
    fi

    # an ellipse arc is a LineString up to its end point
    echo "dwgread -O geojson $DATADIR/2013/gh109_1.dwg | jq ellipse arc"
    if $TESTPROG "./dwgread${EXEEXT}" -O geojson "$DATADIR/2013/gh109_1.dwg" |
        $JQ -e '[.features[] | select(.properties.EntityHandle == "4DF")
                 | .geometry | .type == "LineString"
                   and (.coordinates[-1][0] - 345 | fabs) < 1e-3
                   and (.coordinates[-1][1] + 82.485 | fabs) < 1e-3]
                == [true]' >/dev/null 2>&1
    then
        echo geojson ellipse arc ok
    else
        i=$((i+1))
    fi

    # a full ellipse from pi to 3 pi + 4e-15 is closed, not a tiny arc
    echo "dwgread -O geojson $DATADIR/2013/gh109_1.dwg | jq full ellipse"
    if $TESTPROG "./dwgread${EXEEXT}" -O geojson "$DATADIR/2013/gh109_1.dwg" |
        $JQ -e '[.features[] | select(.properties.EntityHandle == "4F1")
                 | .geometry | .type == "Polygon"
                   and (.coordinates[0] | unique | length > 3)]
                == [true]' >/dev/null 2>&1
    then
        echo geojson full ellipse ok
    else
        i=$((i+1))
    fi

    # a full ellipse is a Polygon, not one point; arcs are LineStrings
    echo "dwgread -O geojson $DATADIR/example_2000.dwg | jq ellipse, arcs"
    if $TESTPROG "./dwgread${EXEEXT}" -O geojson "$DATADIR/example_2000.dwg" |
        $JQ -e '[.features[]
                 | select(.properties.SubClasses // "" | test("AcDbEllipse|AcDbArc"))
                 | .geometry
                 | if .type == "Polygon"
                   then .coordinates[0] | unique | length > 3
                   else .type == "LineString" end]
                | length > 0 and all' >/dev/null 2>&1
    then
        echo geojson ellipse and arcs ok
    else
        i=$((i+1))
    fi

    # OCS: entities with an extrusion other than (0,0,1), made with ezdxf.
    # By layer, in 1/1000: the first point of a LineString, a Point, and the
    # center of the box of a Polygon.
    ocs='[.features[] | select(.properties.Layer // "" | test("NEG|TILT"))
          | {(.properties.Layer): (.geometry
              | if .type == "Point" then .coordinates[0:2]
                elif .type == "Polygon"
                then .coordinates[0] | [(map(.[0]) | (min + max) / 2),
                                        (map(.[1]) | (min + max) / 2)]
                else .coordinates[0] end
              | map(. * 1000 | round))}] | add'
    if [ -x "./dxf2dwg${EXEEXT}" ] &&
       $TESTPROG "./dxf2dwg${EXEEXT}" -y -o OcsEntities.dwg \
           "$DATADIR/2000/OcsEntities.dxf" >/dev/null 2>&1 &&
       $TESTPROG "./dxf2dwg${EXEEXT}" -y -o OcsEntities2.dwg \
           "$DATADIR/2000/OcsEntities2.dxf" >/dev/null 2>&1
    then
        echo "dwgread -O geojson OcsEntities.dwg OcsEntities2.dwg | jq OCS"
        if $TESTPROG "./dwgread${EXEEXT}" -O geojson OcsEntities.dwg 2>/dev/null |
               $JQ -e "$ocs == {ARC_NEG: [7402, 6500], LINE_NEG: [2000, 0],
                                POINT_NEG: [4000, 4000],
                                CIRCLE_TILT: [200, 1000]}" >/dev/null 2>&1 &&
           $TESTPROG "./dwgread${EXEEXT}" -O geojson OcsEntities2.dwg 2>/dev/null |
               $JQ -e "$ocs == {LWPL_NEG: [2000, 1000], LWPL_TILT: [400, 1000],
                                PL2D_NEG: [6000, 6000], TEXT_NEG: [3000, 9000],
                                INSERT_NEG: [4000, 11000],
                                CIRCLE_NEG: [3000, 5000],
                                HATCH_NEG: [10500, 2000]}" >/dev/null 2>&1
        then
            echo geojson ocs ok
        else
            i=$((i+1))
        fi
        rm -f ./OcsEntities.dwg ./OcsEntities2.dwg
    fi
else
    echo no jq, cannot check pipe
fi

if test "0" = "$i" ; then
    exit 0
else
    echo "$(basename "$0"): $i failures"
    ls -l ./*json.log
    exit 1
fi
