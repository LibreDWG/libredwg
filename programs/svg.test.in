#!/bin/sh
# svg.test
#
# Copyright (C) 2020,2023 Free Software Foundation, Inc.
#
# This program is free software, licensed under the terms of the GNU
# General Public License as published by the Free Software Foundation,
# either version 3 of the License, or (at your option) any later version.
# You should have received a copy of the GNU General Public License
# along with this program.  If not, see <http://www.gnu.org/licenses/>.
#
# Author: Reini Urban

[ -z "$DATADIR" ] && DATADIR="@top_srcdir@/test/test-data"
top_builddir="@top_builddir@"
EXEEXT="@EXEEXT@"
TESTS_ENVIRONMENT="@AM_TESTS_ENVIRONMENT@"
# artefact for "shellcheck"
[ -z "$top_builddir" ] && echo $top_builddir
# shellcheck disable=2157
if [ -n "$VALGRIND" ] && [ -n "$LOG_COMPILER" ]; then
    TESTPROG="$LOG_COMPILER $LOG_FLAGS"
elif [ -n "@WINE@" ]; then
    TESTPROG="@WINE@"
elif [ -n "$TESTS_ENVIRONMENT" ]; then
    TESTPROG="$TESTS_ENVIRONMENT @LTEXEC@"
else
    TESTPROG="@LTEXEC@"
fi

i=0
DATA="sample_2000 example_2000 example_2004 example_2007 example_2010"
DATA="$DATA example_2013 example_2018 example_r14"

for d in $DATA; do
    b="$(basename "$d")"
    rm "./$b.svg" 2>/dev/null
done

for dwg in $DATA; do
    svg="$(basename "$dwg" .dwg).svg"
    log="$svg.log"
    dwg="${DATADIR}/$dwg.dwg"
    echo "dwg2SVG${EXEEXT} $dwg >$svg &&"
    echo "  @RUN_JING@ $svg"
    # shellcheck disable=SC2086
    if @TIMEOUT_10@ $TESTPROG "./dwg2SVG${EXEEXT}" "$dwg" >"$svg" 2>"$log" && \
       @RUN_JING@ "$svg"
    then
        rm "./$svg.log" "./$svg"
    else
        cat "$svg.log"
        i=$((i+1))
    fi
done

# a large arc across angle 0, and an ellipse arc as a path
echo "dwg2SVG arcs"
if $TESTPROG "./dwg2SVG${EXEEXT}" "$DATADIR/example_2000.dwg" 2>/dev/null |
       grep -q '<path id="dwg-object-50" d="M [^"]* A [^"]* 0 1,0 ' &&
   $TESTPROG "./dwg2SVG${EXEEXT}" "$DATADIR/2013/gh109_1.dwg" 2>/dev/null |
       grep -q '<path id="dwg-object-408" d="M [^"]* A '
then
    echo svg arcs ok
else
    i=$((i+1))
fi

# OCS: the WCS points of LINE, POINT and MTEXT, also before R13 without an
# extrusion, a mirrored ARC and a tilted CIRCLE
echo "dwg2SVG OCS"
if $TESTPROG "./dwg2SVG${EXEEXT}" "$DATADIR/r11/entities-2d.dwg" 2>/dev/null |
       grep -q 'id="dwg-object-24" d="M 1.139872,6.127279 L 2.139872,5.127279"' &&
   $TESTPROG "./dwg2SVG${EXEEXT}" "$DATADIR/2007/ATMOS-DC22S.dwg" 2>/dev/null |
       grep -q 'id="dwg-object-274" x="1043.513614"'
then
    echo svg ocs ok
else
    i=$((i+1))
fi
# 2000/OcsEntities.dxf is made with ezdxf
if [ -x "./dxf2dwg${EXEEXT}" ] &&
   $TESTPROG "./dxf2dwg${EXEEXT}" -y -o OcsEntities.dwg \
       "$DATADIR/2000/OcsEntities.dxf" >/dev/null 2>&1
then
    $TESTPROG "./dwg2SVG${EXEEXT}" OcsEntities.dwg >OcsEntities.svg 2>/dev/null
    if grep -q 'd="M 8.401924,7.500000 A 3.000000,3.000000 0 0,1 12.500000,6.401924"' OcsEntities.svg &&
       grep -q 'd="M 3.000000,14.000000 L 6.000000,12.000000"' OcsEntities.svg &&
       grep -q 'cx="5.000000" cy="10.000000" r="0.1"' OcsEntities.svg &&
       grep -q 'cx="1.200000" cy="13.000000" r="1.000000"' OcsEntities.svg
    then
        echo svg OcsEntities ok
    else
        i=$((i+1))
    fi
    rm -f ./OcsEntities.dwg ./OcsEntities.svg
fi

if test "0" = "$i" ; then
    exit 0
else
    echo "$(basename "$0"): $i failures"
    ls -l ./*svg.log
    exit 1
fi
