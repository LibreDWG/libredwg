#!/bin/sh
# dxfread.test
#
# Copyright (C) 2026 Free Software Foundation, Inc.
#
# This program is free software, licensed under the terms of the GNU
# General Public License as published by the Free Software Foundation,
# either version 3 of the License, or (at your option) any later version.
# You should have received a copy of the GNU General Public License
# along with this program.  If not, see <http://www.gnu.org/licenses/>.
#
# test dxfread DXF<->JSON converter
# Author: Reini Urban

[ -z "$DATADIR" ] && DATADIR="@top_srcdir@/test/test-data"
top_builddir="@top_builddir@"
# artefact for "shellcheck"
[ -z "$top_builddir" ] && echo "$top_builddir"
EXEEXT="@EXEEXT@"
JQ="@JQ@"

i=0

HAVE_ASAN="@HAVE_ASAN@"
# shellcheck disable=2157
if [ -n "$VALGRIND" ] && [ -n "$LOG_COMPILER" ]; then
    TESTPROG="$LOG_COMPILER $LOG_FLAGS"
elif [ -n "@WINE@" ]; then
    TESTPROG="@WINE@"
elif [ -n "$TESTS_ENVIRONMENT" ]; then
    TESTPROG="$TESTS_ENVIRONMENT @LTEXEC@"
else
    TESTPROG="@LTEXEC@"
fi
if [ -n "$HAVE_ASAN" ]; then
    DXFREAD="env ASAN_OPTIONS=detect_leaks=0 $TESTPROG ./dxfread${EXEEXT}"
else
    DXFREAD="$TESTPROG ./dxfread${EXEEXT}"
fi

# Test 1: DXF -> JSON
# Convert a known DXF file to JSON and check it's valid
check_dxf_to_json() {
    if [ -f "$dxf" ] && [ -x ./dxfread${EXEEXT} ]; then
        json="$(basename "$dxf" .dxf).json"
        log="$json.log"
        rm "./$json" 2>/dev/null
        echo "./dxfread${EXEEXT} -j -o $json $dxf"
        if $DXFREAD -j -o "$json" "$dxf" 2>"$log" >/dev/null; then
            # if jq is not available, we cannot validate the JSON; skip it
            if [ -z "$JQ" ] || $JQ . "$json" >"$log" 2>&1; then
                echo "$json ok"
                rm "./$json" "./$log"
            else
                echo "$json jq fail:"
                cat "$log"
                i=$((i+1))
                rm "./$json"
            fi
        else
            echo "dxfread $dxf failed:"
            cat "$log"
            i=$((i+1))
            rm "./$log"
        fi
    fi
}

# Count group 0 entity records in the ENTITIES section.
# Well-formed DXF: group codes on odd lines, values on even lines.
count_entities() {
    # LC_ALL=C: BSD tr rejects non-ASCII bytes in a UTF-8 locale
    LC_ALL=C tr -d '\r' < "$1" | LC_ALL=C awk '
        { line[NR] = $0 }
        END {
            sec = ""; wantname = 0; n = 0
            for (i = 1; i + 1 <= NR; i += 2) {
                code = line[i]; val = line[i + 1]
                gsub(/^[ \t]+|[ \t\r]+$/, "", code)
                gsub(/^[ \t]+|[ \t\r]+$/, "", val)
                if (wantname) { wantname = 0; if (code == "2") sec = val }
                else if (code == "0") {
                    if (val == "SECTION")
                        wantname = 1
                    else if (val == "ENDSEC")
                        sec = ""
                    else if (val != "HEADER" && val != "CLASSES" && val != "TABLES" \
                             && val != "BLOCKS" && val != "ENTITIES" && val != "OBJECTS" \
                             && val != "THUMBNAILIMAGE")
                        if (sec == "ENTITIES") n++
                }
            }
            print n
        }'
}

# Test 2: JSON -> DXF roundtrip
# Convert DXF -> JSON -> DXF and check the entity count
check_roundtrip() {
    if [ -f "$dxf" ] && [ -x ./dxfread${EXEEXT} ]; then
        json="$(basename "$dxf" .dxf).rt.json"
        dxf2="$(basename "$dxf" .dxf).rt.dxf"
        log="$json.log"
        rm "./$json" "./$dxf2" 2>/dev/null
        # DXF -> JSON
        if ! $DXFREAD -j -o "$json" "$dxf" 2>"$log" >/dev/null; then
            echo "dxfread DXF->JSON $dxf failed:"
            cat "$log"
            i=$((i+1))
            rm "./$log"
            return
        fi
        # JSON -> DXF
        if ! $DXFREAD -d -o "$dxf2" "$json" 2>"$log" >/dev/null; then
            echo "dxfread JSON->DXF $json failed:"
            cat "$log"
            i=$((i+1))
            rm "./$json" "./$log"
            return
        fi
        # Check the entity count is mostly preserved. The JSON roundtrip
        # currently drops some non-essential objects (MATERIAL, polyline
        # vertices in some files), so allow up to 25% loss, but a
        # catastrophically truncated output must fail.
        expect="$(count_entities "$dxf")"
        got="$(count_entities "$dxf2")"
        if [ "$expect" -eq 0 ] || [ "$((got * 4))" -ge "$((expect * 3))" ]; then
            echo "$dxf2 roundtrip ok ($got/$expect entities)"
        else
            echo "$dxf2 roundtrip fail: got $got < 75% of $expect entities"
            i=$((i+1))
            echo "expect=$expect" >"$log"
            echo "got=$got" >>"$log"
        fi
        rm "./$json" "./$dxf2" "./$log" 2>/dev/null
    fi
}

# Run tests on known DXF files
for dxf in \
    "$DATADIR"/sample_2000.dxf \
    "$DATADIR"/example_2000.dxf \
    "$DATADIR"/example_2004.dxf \
    "$DATADIR"/2000/circle.dxf \
    "$DATADIR"/2000/Text.dxf \
    "$DATADIR"/2000/Arc.dxf
do
    check_dxf_to_json
    check_roundtrip
done

# Test 3: DXF -> JSON -> DXF via pipe (stdout/stdin)
dxf="$DATADIR/sample_2000.dxf"
if [ -f "$dxf" ] && [ -x ./dxfread${EXEEXT} ]; then
    log="pipe_test.log"
    # DXF -> JSON (stdout) -> DXF (stdin)
    if $DXFREAD -j "$dxf" 2>/dev/null | \
       $DXFREAD -d - 2>"$log" | \
       LC_ALL=C tr -d '\r' | \
       grep -qE '^ *0$'
    then
        echo "pipe roundtrip ok"
        rm "./$log" 2>/dev/null
    else
        echo "pipe roundtrip fail:"
        cat "$log"
        i=$((i+1))
        rm "./$log" 2>/dev/null
    fi
fi

if test "0" = "$i" ; then
    exit 0
else
    echo "$(basename "$0"): $i failures"
    ls -l ./*log 2>/dev/null
    exit 1
fi
