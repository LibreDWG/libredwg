/*
 * version.c.in: generated to version.c by configure or cmake.
 * The only file which depends on the package version, so that a new version
 * does not rebuild or invalidate the cache of all the other objects.
 * config.h has no PACKAGE_VERSION and PACKAGE_STRING.
 */

#include "config.h" /* ENABLE_SHARED for EXPORT (dllexport on mingw) */
#include "dwg.h"

/* ie PACKAGE_VERSION */
EXPORT const char *
dwg_api_version_string (void)
{
  return "@PACKAGE_VERSION@";
}

/* ie PACKAGE_STRING */
EXPORT const char *
dwg_api_package_string (void)
{
  return "LibreDWG @PACKAGE_VERSION@";
}
